#!/bin/sh
set -eu

# Run only the binary bundled beside this launcher. The installed plugin root
# is self-contained and must not depend on the checkout or the caller's PATH.
launcher_dir=$(CDPATH= cd "$(dirname "$0")" && pwd -P)
research_binary="$launcher_dir/orbit-research.bin"

json_escape() {
    # Append a record separator to retain any original trailing newline.
    # C locale preserves UTF-8 bytes while escaping all JSON control bytes.
    printf '%s\n' "$1" | LC_ALL=C awk '
        BEGIN {
            for (i = 1; i < 32; i++) escaped[sprintf("%c", i)] = sprintf("\\u%04x", i)
            escaped["\\"] = "\\\\"
            escaped["\""] = "\\\""
        }
        NR > 1 { printf "\\n" }
        {
            for (i = 1; i <= length($0); i++) {
                c = substr($0, i, 1)
                printf "%s", (c in escaped ? escaped[c] : c)
            }
        }'
}

incompatible() {
    path=$(json_escape "${research_binary:-<not found>}")
    printf '{"ok":false,"error":{"code":"incompatible_binary","message":"orbit-research at %s must support the orbit-tool exec envelope","retryable":false,"detail":{"path":"%s"}}}\n' "$path" "$path"
    exit 0
}

[ -n "$research_binary" ] || incompatible
[ -x "$research_binary" ] || incompatible

exec "$research_binary" "$@"
