{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "acceptance_criteria": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "context_files": {
      "default": null,
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "request_key": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "research_id": {
      "pattern": "^R[0-9]{3}$",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "request_key",
    "research_id",
    "title"
  ],
  "title": "LinkInput",
  "type": "object"
}
