{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "One tool, three drafting shapes. `shape` selects the variant; each carries only the fields that shape needs.",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "objective": {
          "minLength": 1,
          "type": "string"
        },
        "research_id": {
          "minLength": 1,
          "type": "string"
        },
        "shape": {
          "enum": [
            "investigation"
          ],
          "type": "string"
        }
      },
      "required": [
        "objective",
        "research_id",
        "shape"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "objective": {
          "minLength": 1,
          "type": "string"
        },
        "research_id": {
          "minLength": 1,
          "type": "string"
        },
        "shape": {
          "enum": [
            "contribution"
          ],
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "objective",
        "research_id",
        "shape",
        "unit"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "research_id": {
          "minLength": 1,
          "type": "string"
        },
        "shape": {
          "enum": [
            "synthesis"
          ],
          "type": "string"
        },
        "units": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "research_id",
        "shape",
        "units"
      ],
      "type": "object"
    }
  ],
  "title": "Plan"
}
