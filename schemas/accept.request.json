{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AcceptInput",
  "type": "object",
  "required": [
    "research_id",
    "task_id"
  ],
  "properties": {
    "research_id": {
      "type": "string",
      "pattern": "^R[0-9]{3}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
