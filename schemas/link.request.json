{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LinkInput",
  "type": "object",
  "required": [
    "request_key",
    "research_id",
    "title"
  ],
  "properties": {
    "acceptance_criteria": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "request_key": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1
    },
    "research_id": {
      "type": "string",
      "pattern": "^R[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
