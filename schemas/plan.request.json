{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plan",
  "description": "One tool, three drafting shapes. `shape` selects the variant; each carries only the fields that shape needs.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "objective",
        "research_id",
        "shape"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "research_id": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "string",
          "enum": [
            "investigation"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "objective",
        "research_id",
        "shape",
        "unit"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "research_id": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "string",
          "enum": [
            "contribution"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "research_id",
        "shape",
        "units"
      ],
      "properties": {
        "research_id": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "string",
          "enum": [
            "synthesis"
          ]
        },
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
