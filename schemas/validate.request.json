{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ValidateInput",
  "type": "object",
  "required": [
    "path"
  ],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "research_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^R[0-9]{3}$"
    }
  },
  "additionalProperties": false
}
