{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbit-research:schema:v2:export",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "export"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "manifests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:orbit-research:schema:v1:manifest"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "records",
    "manifests",
    "unresolved"
  ],
  "additionalProperties": false
}
